include *.json
include *.md
include *.py
include COPYRIGHT
include uv.lock
recursive-include tests *.py
# This repository-publication test deliberately requires the Git object
# database and historical commits; those do not exist inside an sdist.
exclude tests/test_hswm_swm0r_ontology.py
exclude tests/test_hswm_swm0w_ontology.py
# These checkpoint tests bind repository-only TypeScript sources, workflows,
# and Git history.  The separate Effect npm artifact is deliberately pruned
# below, so transporting these tests in the Python sdist creates an impossible
# test surface rather than validating the published Python package.
recursive-exclude tests test_hswm_swm0w_s2s_effect_handoff_v*.py
# DNRD is a repository-only cross-language research diagnostic. Its tests bind
# the checked-in Effect sources, Git chronology, and hosted-CI workflow, all of
# which are intentionally outside the Python source distribution below.
recursive-exclude tests test_hswm_dnrd_*.py
# The narrowly named test_dnrd5_* suites below are synthetic Python contract
# tests; they neither import the pruned Effect runtime nor require Git history.
# Keep them in the sdist with their _research/dnrd5 Python implementations.
# Frozen test receipts are read directly by source-distribution tests.
recursive-include tests/fixtures *.json
# SWM-0W's repository-only cryptographic verifier is required by its source
# distribution conformance tests. node_modules remains an install-time input.
include tools/swm0w_drand/.gitignore
include tools/swm0w_drand/.npmrc
include tools/swm0w_drand/README.md
include tools/swm0w_drand/package.json
include tools/swm0w_drand/package-lock.json
include tools/swm0w_drand/verify-beacon.mjs
recursive-include tools/swm0w_drand/fixtures *.json
# scripts/ is an implicit-namespace package imported by contract tests.
# research/ and schemas/ contain the corresponding data contracts.
recursive-include scripts *.py *.sh
recursive-include src *.py *.md
# The TypeScript/Effect runtime is a separate locked npm artifact. Never let a
# maintainer's local node_modules or its source maps leak into the Python sdist.
prune src/hswm/effect-runtime
recursive-include research *.json
recursive-include ontology *.json *.md
recursive-include schemas *.json
recursive-include docs *.md *.txt
recursive-include docs/assets *.png
recursive-include prereg *.json *.md
recursive-include evidence *.json
recursive-include formal *.py *.lean *.json *.toml
recursive-include verification *.py *.json *.md
recursive-include results *.md *.log *.json
recursive-include manifests *.json
recursive-include receipts *.py *.json
# The S2S pilot adoption is a five-file replay bundle. The raw ZIP stays
# byte-exact so an sdist can reconstruct the selected protocol configuration
# after the GitHub-hosted copy expires.
recursive-include artifacts/swm0w_s2s/pilot_adoption *.json *.zip
recursive-include prom_search_hswm *.py *.json *.md *.mmd *.sh
recursive-exclude prom_search_hswm/data *
include prom_search_hswm/data/README.md
include prom_search_hswm/data/gold_badiou24.json
recursive-include _research *.py *.json *.md *.sh *.tsv
# MI-1's transported tests and freezer bind these exact public Q1-v3 source
# bytes. Keep both paths literal so unrelated or private text/binary artifacts
# cannot be swept into the Python source distribution by broad glob rules.
include _research/dgx_q1/preregistrations/hswm-dnrd5-dgx-live-q1-v3-2026-08-29/materials/QCASE-024/instruction.txt
include _research/dgx_q1/preregistrations/hswm-dnrd5-dgx-live-q1-v3-2026-08-29/materials/QCASE-024/rng.bin
include _research/dgx_mi2/preregistrations/hswm-dnrd5-qcase024-mi-2-launch-crossed-v1-2026-08-29/materials/QCASE-024/instruction.txt
include _research/dgx_mi2/preregistrations/hswm-dnrd5-qcase024-mi-2-launch-crossed-v1-2026-08-29/materials/QCASE-024/rng.bin
# DNRD-5's content-addressed actual-byte fixture uses extensionless SHA-256
# filenames.  Its Python judge test ships in the sdist, so the bound CAS bytes
# must travel with the manifest rather than leaving an impossible test surface.
recursive-include _research/dnrd5/vectors/actual_byte_corpus_v1/blobs *
include _research/root_compat/pyproject.toml
