{
  "_tag": "HSWMStandardResearchJobProfiles",
  "contractVersion": "hswm-standard-research-job-profiles/v1",
  "profiles": [
    {
      "action": {
        "argv": [
          "${PYTHON_EXECUTABLE}",
          "-m",
          "_research.dgx_q1.live_experiment",
          "--repo-root",
          "${REPO_ROOT}",
          "--expected-commit",
          "${EXPECTED_COMMIT}",
          "--expected-tree",
          "${EXPECTED_TREE}",
          "--publication-ci-receipt",
          "${PUBLICATION_CI_RECEIPT}",
          "--publication-ci-receipt-sha256",
          "${PUBLICATION_CI_RECEIPT_SHA256}",
          "--freeze-root",
          "${FREEZE_ROOT}",
          "--plan-sha256",
          "${PLAN_SHA256}",
          "--lock-path",
          "${LOCK_PATH}",
          "--container-name",
          "${CONTAINER_NAME}",
          "--model-snapshot",
          "${MODEL_SNAPSHOT}"
        ],
        "cwd": "${REPO_ROOT}",
        "environment": {
          "HSWM_CACHE_ROOT": "${CACHE_ROOT}",
          "HSWM_OUTPUT_ROOT": "${OUTPUT_ROOT}"
        },
        "timeoutMs": 86400000
      },
      "frozenInputs": [
        {"binding": "FREEZE_CLOSURE_MANIFEST", "mediaType": "application/json"},
        {"binding": "FREEZE_PLAN", "mediaType": "application/json"},
        {"binding": "ACTION_SOURCE", "mediaType": "text/x-python"},
