        "PYTHON_EXECUTABLE",
        "REPO_ROOT",
        "VERIFIER_SOURCE"
      ],
      "verifier": {
        "acceptExitCodes": [0],
        "command": {
          "argv": [
            "${PYTHON_EXECUTABLE}",
