        "USER_DIRECT_SOURCE"
      ],
      "direction": "container/claim/slot -> referenced record",
      "cardinality": "1 for participation targets; 0..n otherwise",
      "meaning": "Typed membership or reference; not subclass, sameAs or causal influence."
    },
    {
      "predicate": "HAS_PARTICIPATION",
      "domain_roles": [
        "CLAIM"
      ],
      "range_roles": [
        "ROLE_PARTICIPATION"
      ],
      "direction": "qualified claim -> ordered role slot",
      "cardinality": "exactly 3 on the ideal-naming claim",
      "meaning": "Preserves subject, name reference and speaker-source roles."
    },
    {
      "predicate": "REFERENCES",
      "domain_roles": [
        "CLAIM",
        "EVALUATION_PLAN",
        "LITERATURE_REVIEW"
      ],
      "range_roles": [
        "EXTERNAL_ANCHOR",
        "ENGINEERING_SOURCE",
        "CLAIM",
        "LITERATURE_REVIEW"
      ],
      "direction": "interpretation/plan -> target",
      "cardinality": "0..n",
      "meaning": "Research relevance; no entailment, authority transfer or deployment."
    },
    {
      "predicate": "CONSTRAINS",
      "domain_roles": [
        "DECISION",
        "LITERATURE_REVIEW"
      ],
      "range_roles": [
        "CLAIM",
        "LITERATURE_REVIEW"
      ],
      "direction": "assessment/limitation -> claim/review",
      "cardinality": "exactly 1 claim per decision",
      "meaning": "Restricts interpretation or records an assessment; not an overwrite of source."
    }
