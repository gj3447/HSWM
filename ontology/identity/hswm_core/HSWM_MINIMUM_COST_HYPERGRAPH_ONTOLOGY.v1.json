    {"uid":"sym:AbstractNode:hswm-minimum-cost-operational-map-2026-09-27","labels":["Concept","AbstractNode"],"properties":{"name":"Map operational interpretation","description":"Map identifies source and target model versions, state correspondence, observations, allowed interventions, time and declared losses without fixing a mandatory physical-to-synaptic-to-semantic pipeline.","standard_graph_role":"SECONDARY_AI_OPERATIONAL_INTERPRETATION","authority_class":"SECONDARY_AI","source_path":"docs/research/HSWM_INTUITION_STANDARD_GRAPH_SYNTHESIS_2026-09-27.md","source_sha256":"0df015feb102bff9f1580542736a5112ea4d7f78171787e63dabc4cc359c7675","status":"ENGINEERING_INTERPRETATION","claim_boundary":"MAPPING_CONTRACT_NOT_BRAIN_REALIZATION","projection_nonclaim":"NOT_A_NEW_COGNITIVE_SUBSYSTEM"}},
    {"uid":"sym:Concept:hswm-lit-world-models-2018","labels":["Concept"],"properties":{"name":"World Models literature constraint","description":"World Models demonstrates a concrete compressed environment model for prediction and policy, not a necessary definition of every AI or a proof of hypergraph necessity.","standard_graph_role":"LITERATURE_CONSTRAINT","authority_class":"SECONDARY_AI","source_authority":"PRIMARY_RESEARCH","external_url":"https://arxiv.org/abs/1803.10122","source_path":"docs/research/HSWM_INTUITION_STANDARD_GRAPH_SYNTHESIS_2026-09-27.md","source_sha256":"0df015feb102bff9f1580542736a5112ea4d7f78171787e63dabc4cc359c7675","status":"SOURCE_REVIEWED","claim_boundary":"CONCRETE_DESIGN_NOT_UNIVERSAL_AI_DEFINITION","projection_nonclaim":"NOT_HSWM_EFFICACY_EVIDENCE"}},
    {"uid":"sym:Concept:hswm-lit-information-bottleneck-1999","labels":["Concept"],"properties":{"name":"Information Bottleneck literature constraint","description":"Information Bottleneck defines target-relative compression for a specified joint distribution, not intervention sufficiency or a particular graph or LLM cost optimum.","standard_graph_role":"LITERATURE_CONSTRAINT","authority_class":"SECONDARY_AI","source_authority":"PRIMARY_RESEARCH","external_url":"https://www.princeton.edu/~wbialek/our_papers/tishby%2Bal_99.pdf","source_path":"docs/research/HSWM_INTUITION_STANDARD_GRAPH_SYNTHESIS_2026-09-27.md","source_sha256":"0df015feb102bff9f1580542736a5112ea4d7f78171787e63dabc4cc359c7675","status":"SOURCE_REVIEWED","claim_boundary":"FIXED_TARGET_AND_DISTRIBUTION","projection_nonclaim":"NOT_A_DATA_STRUCTURE_OPTIMALITY_PROOF"}},
    {"uid":"sym:Concept:hswm-lit-causal-states-2001","labels":["Concept"],"properties":{"name":"Causal states literature constraint","description":"Causal states yield a minimum state entropy result among prescient representations for a discrete stationary process with its exact predictive distribution.","standard_graph_role":"LITERATURE_CONSTRAINT","authority_class":"SECONDARY_AI","source_authority":"PRIMARY_RESEARCH","external_url":"https://csc.ucdavis.edu/~cmg/papers/cmppss.pdf","source_path":"docs/research/HSWM_INTUITION_STANDARD_GRAPH_SYNTHESIS_2026-09-27.md","source_sha256":"0df015feb102bff9f1580542736a5112ea4d7f78171787e63dabc4cc359c7675","status":"SOURCE_REVIEWED","claim_boundary":"STATIONARY_PREDICTION_NOT_INTERVENTION_OR_LLM_COST","projection_nonclaim":"NOT_A_GENERAL_HSWM_MINIMUM_RESULT"}},
    {"uid":"sym:Concept:hswm-lit-mdl","labels":["Concept"],"properties":{"name":"Minimum Description Length literature constraint","description":"MDL compares model and data description length in a declared code and model class; shorter code does not automatically imply lower execution or learning cost.","standard_graph_role":"LITERATURE_CONSTRAINT","authority_class":"SECONDARY_AI","source_authority":"PRIMARY_RESEARCH","external_url":"https://arxiv.org/abs/math/0406077","source_path":"docs/research/HSWM_INTUITION_STANDARD_GRAPH_SYNTHESIS_2026-09-27.md","source_sha256":"0df015feb102bff9f1580542736a5112ea4d7f78171787e63dabc4cc359c7675","status":"SOURCE_REVIEWED","claim_boundary":"CODE_RELATIVE_DESCRIPTION_LENGTH","projection_nonclaim":"NOT_UNIVERSAL_HYPERGRAPH_OPTIMALITY"}},
    {"uid":"sym:Concept:hswm-lit-factor-graphs-2001","labels":["Concept"],"properties":{"name":"Factor Graphs literature constraint","description":"Factor graphs represent local multivariable factors using variable-factor incidence, showing that n-ary meaning can coexist with binary storage edges.","standard_graph_role":"LITERATURE_CONSTRAINT","authority_class":"SECONDARY_AI","source_authority":"PRIMARY_RESEARCH","external_url":"https://www.isiweb.ee.ethz.ch/papers/arch/aloe-2001-1.pdf","source_path":"docs/research/HSWM_INTUITION_STANDARD_GRAPH_SYNTHESIS_2026-09-27.md","source_sha256":"0df015feb102bff9f1580542736a5112ea4d7f78171787e63dabc4cc359c7675","status":"SOURCE_REVIEWED","claim_boundary":"FACTORISATION_AND_LOCAL_COMPUTATION_MUST_BE_ESTABLISHED","projection_nonclaim":"NOT_A_FREE_HIGH_ARITY_COST_CLAIM"}},
