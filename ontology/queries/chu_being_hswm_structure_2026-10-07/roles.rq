PREFIX kb: <https://hswm.invalid/kg-bundle-rdf/v1/>
PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>
SELECT ?uid ?role ?ordinal ?targetUid ?qualification WHERE {
 ?claim p:claim_type "STRUCTURE_BEING_DISTINCTION" ; r:HAS_PARTICIPATION ?slot .
 ?slot kb:uid ?uid ; p:role ?role ; p:ordinal ?ordinal ; p:qualification ?qualification ; r:HAS_CONCEPT/kb:uid ?targetUid .
} ORDER BY ?ordinal
