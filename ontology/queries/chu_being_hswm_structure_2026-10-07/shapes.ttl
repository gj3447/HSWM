@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix kb: <https://hswm.invalid/kg-bundle-rdf/v1/> .
@prefix p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/> .
@prefix r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/> .
@prefix role: <https://hswm.invalid/kg-bundle-rdf/v1/role/> .
@prefix s: <urn:hswm:chu-being:shape:> .

s:Provenance a sh:NodeShape ; sh:targetClass kb:Node ;
 sh:property [ sh:path p:source_path ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:source_sha256 ; sh:pattern "^[0-9a-f]{64}$" ; sh:minCount 1 ; sh:maxCount 1 ] .
s:Claim a sh:NodeShape ; sh:targetClass role:CLAIM ;
 sh:property [ sh:path p:authority_class ; sh:hasValue "USER_PRIMARY" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:scientific_status ; sh:hasValue "NOT_EVALUATED" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:status ; sh:hasValue "USER_VIEWPOINT_RECORDED" ; sh:maxCount 1 ] ;
 sh:property [ sh:path r:HAS_SOURCE ; sh:class role:USER_DIRECT_SOURCE ; sh:minCount 1 ; sh:maxCount 1 ] .
s:UserSource a sh:NodeShape ; sh:targetClass role:USER_DIRECT_SOURCE, role:USER_DIRECT_REQUEST ;
 sh:property [ sh:path p:authority_class ; sh:hasValue "USER_PRIMARY" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:utterance_verbatim ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .
s:Artifact a sh:NodeShape ; sh:targetClass role:SOURCE_ARTIFACT ;
 sh:property [ sh:path p:authority_class ; sh:hasValue "SOURCE_DECLARED" ; sh:maxCount 1 ] .
s:Decision a sh:NodeShape ; sh:targetClass role:DECISION ;
 sh:property [ sh:path p:evidence_disposition ; sh:hasValue "NOT_EVALUATED" ; sh:maxCount 1 ] .
s:Definition a sh:NodeShape ; sh:targetClass role:SOURCE_DEFINITION ;
 sh:property [ sh:path p:authority_class ; sh:hasValue "SOURCE_DECLARED" ; sh:maxCount 1 ] ;
 sh:property [ sh:path r:HAS_SOURCE ; sh:class role:SOURCE_ARTIFACT ; sh:minCount 1 ; sh:maxCount 1 ] .
s:Binding a sh:NodeShape ; sh:targetClass role:AXIOM_BINDING ;
 sh:property [ sh:path p:authority_class ; sh:hasValue "SECONDARY_AI" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:status ; sh:hasValue "PROPOSED" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:mapping_status ; sh:hasValue "PROPOSED_NOT_OPERATIONALIZED" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:semantic_status ; sh:hasValue "UNRESOLVED" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:formula_status ; sh:hasValue "UNSPECIFIED_IN_SOURCE" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:evil_formula ; sh:maxCount 0 ] ;
 sh:property [ sh:path p:runtime_admitted ; sh:hasValue false ; sh:maxCount 1 ] ;
 sh:property [ sh:path r:HAS_SOURCE ; sh:class role:SOURCE_DEFINITION ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path r:REFERENCES ; sh:class role:OPEN_QUESTION ; sh:minCount 1 ; sh:maxCount 1 ] .
s:Open a sh:NodeShape ; sh:targetClass role:OPEN_QUESTION ;
 sh:property [ sh:path p:status ; sh:hasValue "OPEN" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:question ; sh:minCount 1 ; sh:maxCount 1 ] .
s:Interpretation a sh:NodeShape ; sh:targetClass role:AI_INTERPRETATION ;
 sh:property [ sh:path p:authority_class ; sh:hasValue "SECONDARY_AI" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:perfect_understanding_demonstrated ; sh:hasValue false ; sh:maxCount 1 ] .
s:Slot a sh:NodeShape ; sh:targetClass role:ROLE_PARTICIPATION ;
 sh:property [ sh:path p:authority_class ; sh:hasValue "SECONDARY_AI" ; sh:maxCount 1 ] ;
 sh:property [ sh:path r:HAS_CONCEPT ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path r:HAS_SOURCE ; sh:class role:USER_DIRECT_SOURCE ; sh:minCount 1 ; sh:maxCount 1 ] .

s:Definition01 a sh:NodeShape ; sh:targetNode <urn:hswm:kg:node:sym:Concept:chu-being-axiom-01-2026-10-07> ;
 sh:property [ sh:path p:standard_graph_role ; sh:hasValue "SOURCE_DEFINITION" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:ordinal ; sh:hasValue 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:name ; sh:hasValue "시간" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:definition_verbatim ; sh:hasValue "어떤 연속적인 흐름." ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:source_line ; sh:hasValue 3 ; sh:maxCount 1 ] .

