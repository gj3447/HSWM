 sh:property [ sh:path p:claim_type ; sh:hasValue "STRUCTURE_BEING_DISTINCTION" ; sh:maxCount 1 ] ;
 sh:property [ sh:path p:utterance_excerpt ; sh:hasValue "HSWM 는 구조를 말하고 그 존재자체는 지능 존재자체는 CHU 로 보는것이 맞는것같아 내생각에는 ㅇㅇ 이해되냐 ㅇㅇ?" ; sh:maxCount 1 ] .

