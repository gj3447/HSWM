PREFIX kb: <https://hswm.invalid/kg-bundle-rdf/v1/>
PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
SELECT ?uid ?role ?ordinal ?qualification ?targetUid ?authority WHERE {
  ?claim p:claim_type "CONDITIONAL_AI_IDENTITY_VIEWPOINT" ; r:HAS_PARTICIPATION ?slot .
  ?slot kb:uid ?uid ; p:role ?role ; p:ordinal ?ordinal ; p:qualification ?qualification ;
    p:authority_class ?authority ; r:HAS_CONCEPT/kb:uid ?targetUid .
} ORDER BY ?ordinal
