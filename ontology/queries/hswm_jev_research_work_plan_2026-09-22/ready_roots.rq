PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>
PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
SELECT ?taskId ?track WHERE {
  ?task a role:WORK_PACKAGE; p:task_id ?taskId; p:track ?track; p:status "PLANNED" .
  FILTER NOT EXISTS { ?task r:DEPENDS_ON ?dep . ?dep p:status ?s . FILTER(?s != "COMPLETE") }
  FILTER NOT EXISTS { ?task r:REQUIRES_START_DECISION ?d . ?d p:status ?s . FILTER(?s != "SATISFIED") }
} ORDER BY ?taskId
