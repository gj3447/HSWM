PREFIX kb: <https://hswm.invalid/kg-bundle-rdf/v1/>
PREFIX kbp: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX kbr: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
PREFIX kbrole: <https://hswm.invalid/kg-bundle-rdf/v1/role/>

SELECT ?topic ?topicName ?snapshot ?sourcePath ?rawSourceStatus ?navigationStatus ?sourceBundleUid
WHERE {
  <urn:hswm:kg:node:sym:AbstractNode:hswm-knowledge-map-2026-09-13>
    kbr:HAS_CONCEPT ?topic .
  ?topic a kbrole:KNOWLEDGE_MAP_TOPIC ;
    kbp:name ?topicName ;
    kbr:HAS_SOURCE ?snapshot .
  ?snapshot a kbrole:SOURCE_SNAPSHOT ;
    kbp:navigation_status "CURRENT_ENTRYPOINT" ;
    kbp:source_path ?sourcePath ;
    kbp:raw_source_status ?rawSourceStatus .
  OPTIONAL { ?snapshot kbp:source_bundle_uid ?sourceBundleUid }
}
ORDER BY ?topicName ?sourcePath ?snapshot
