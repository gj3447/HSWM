PREFIX kb: <https://hswm.invalid/kg-bundle-rdf/v1/>
PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
SELECT ?uid ?name ?status ?observation ?failureCondition ?implementation WHERE {
  ?plan p:standard_graph_role "EVALUATION_PLAN" ; kb:uid ?uid ; p:name ?name ;
    p:status ?status ; p:observation_status ?observation ; p:description ?failureCondition ;
    r:REFERENCES ?target .
  ?target p:standard_graph_role "ENGINEERING_SOURCE" ; p:source_path ?implementation .
} ORDER BY ?uid
