PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>
PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>

SELECT ?task ?taskId ?dependency ?dependencyId ?dependencyStatus WHERE {
 ?task a role:WORK_PACKAGE ; p:task_id ?taskId ; r:DEPENDS_ON+ ?dependency .
 ?dependency p:task_id ?dependencyId ; p:status ?dependencyStatus .
} ORDER BY ?taskId ?dependencyId
