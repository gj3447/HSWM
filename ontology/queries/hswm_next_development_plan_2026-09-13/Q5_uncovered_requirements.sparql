PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>
PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>

SELECT ?requirement ?requirementId ?status ?reuseEvidence WHERE {
 ?requirement a role:AUDIT_REQUIREMENT ; p:requirement_id ?requirementId ; p:status ?status .
 OPTIONAL { ?requirement r:REUSES_EVIDENCE ?reuseEvidence }
 FILTER NOT EXISTS { ?task a role:WORK_PACKAGE ; r:ADDRESSES ?requirement }
 FILTER(?requirementId != "s5-navigation-stale" || ?status != "REUSE_COMPLETED_SUCCESSOR_READING" || !BOUND(?reuseEvidence))
} ORDER BY ?requirementId
