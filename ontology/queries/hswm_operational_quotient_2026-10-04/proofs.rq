PREFIX kb: <https://hswm.invalid/kg-bundle-rdf/v1/>
PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
SELECT ?uid ?theorem ?status ?sourcePath ?sourceSha256 WHERE {
  ?claim p:standard_graph_role "FORMAL_RESULT" ; kb:uid ?uid ; p:theorem ?theorem ; p:status ?status ; r:HAS_SOURCE ?source .
  ?source p:standard_graph_role "PROOF_SOURCE" ; p:source_path ?sourcePath ; p:source_sha256 ?sourceSha256 .
} ORDER BY ?uid
