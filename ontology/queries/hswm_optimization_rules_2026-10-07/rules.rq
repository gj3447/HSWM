PREFIX kb: <https://hswm.invalid/kg-bundle-rdf/v1/>
PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>
SELECT ?id ?name ?directive ?source ?section ?intentSource ?authority WHERE {
 ?rule a role:OPTIMIZATION_RULE ; p:rule_id ?id ; p:name ?name ; p:directive ?directive ;
   p:source_path ?source ; p:source_section ?section ; p:authority_class ?authority ;
   r:HAS_SOURCE/p:source_path ?intentSource .
} ORDER BY ?id
