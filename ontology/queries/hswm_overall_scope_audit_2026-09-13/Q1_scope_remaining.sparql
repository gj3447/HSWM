PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>
PREFIX edge: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
SELECT ?name ?status ?remaining WHERE { ?s a role:ENGINEERING_SCOPE; p:name ?name; p:status ?status; p:remaining ?remaining. FILTER(?status IN ("PARTIAL", "UNKNOWN", "UNJUDGED")) } ORDER BY ?name
