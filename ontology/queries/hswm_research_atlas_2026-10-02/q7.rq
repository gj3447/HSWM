PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>

SELECT DISTINCT ?sourcePath ?targetPath WHERE {
  ?source a role:SOURCE_VIEW ; p:source_path ?sourcePath ; r:CITES ?target .
  ?target a role:SOURCE_VIEW ; p:source_path ?targetPath .
}
ORDER BY ?sourcePath ?targetPath
