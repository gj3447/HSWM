PREFIX kb: <https://hswm.invalid/kg-bundle-rdf/v1/>
PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>

SELECT ?key ?finding ?eventDate ?scope ?source WHERE {
 ?c a role:RESEARCH_SYNTHESIS ; p:record_key ?key ; p:negative_or_limiting_result true ;
 p:description ?finding ; p:event_date ?eventDate ; p:claim_boundary ?scope ; p:source_path ?source .
} ORDER BY ?eventDate ?key
