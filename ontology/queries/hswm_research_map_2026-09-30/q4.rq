PREFIX kb: <https://hswm.invalid/kg-bundle-rdf/v1/>
PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>

SELECT ?obligation ?title ?historicalStatus ?statusDate ?currentReferenceStatus ?originalUid ?source WHERE {
 ?o a role:EXISTING_OBLIGATION_REFERENCE ; p:obligation_id ?obligation ; p:name ?title ;
 p:source_status ?historicalStatus ; p:source_status_as_of ?statusDate ; p:status ?currentReferenceStatus ;
 p:original_uid ?originalUid ; p:source_path ?source ; p:discharged_by_this_map false .
} ORDER BY ?obligation
