PREFIX kbp: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX kbr: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>

SELECT ?candidateId ?candidateName ?decision ?priority ?qualificationId ?qualificationStatus
WHERE {
<urn:hswm:kg:node:sym:AbstractNode:hswm-scientific-research-tooling-2026-09-13> kbr:HAS_CONCEPT ?a .
?a a role:INTEGRATED_ASSESSMENT ; kbp:candidate_id ?candidateId ; kbp:decision ?decision ; kbr:REFERS_TO ?c ; kbr:HAS_CONCEPT ?q .
?c a role:TOOL_CANDIDATE ; kbp:name ?candidateName .
?q a role:QUALIFICATION ; kbp:id ?qualificationId ; kbp:priority ?priority ; kbp:source_status ?qualificationStatus .
}
ORDER BY ?candidateId
