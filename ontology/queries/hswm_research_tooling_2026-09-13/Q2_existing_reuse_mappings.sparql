PREFIX kbp: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX kbr: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>

SELECT ?candidateId ?decision ?capabilityId ?capabilityName
WHERE {
<urn:hswm:kg:node:sym:AbstractNode:hswm-scientific-research-tooling-2026-09-13> kbr:HAS_CONCEPT ?a .
?a a role:INTEGRATED_ASSESSMENT ; kbp:candidate_id ?candidateId ; kbp:decision ?decision ; kbr:PRESERVES ?cap .
?cap a role:EXISTING_CAPABILITY ; kbp:id ?capabilityId ; kbp:name ?capabilityName .
}
ORDER BY ?candidateId ?capabilityId
