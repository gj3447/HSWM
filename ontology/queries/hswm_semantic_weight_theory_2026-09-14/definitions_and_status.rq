PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
SELECT DISTINCT ?definition ?method ?obligation ?sourceStatus ?status ?authority WHERE {
  ?d p:standard_graph_role "THEORY_DEFINITION"; p:definition_id ?definition.
  ?d (r:CONSTRAINS_ADOPTION|r:SUPPLIES_DEFINITION/r:CONSTRAINS_ADOPTION) ?connection.
  ?connection p:connection_id ?method;
              r:ADDRESSES_EXISTING_OBLIGATION ?reference.
  ?reference p:obligation_id ?obligation;
             p:source_status ?sourceStatus;
             p:status ?status;
             p:authority_class ?authority.
} ORDER BY ?definition ?method ?obligation
