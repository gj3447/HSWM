@prefix p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/> .
@prefix r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/> .
@prefix role: <https://hswm.invalid/kg-bundle-rdf/v1/role/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix archive: <urn:hswm:source-archive:shape:> .

archive:Content a sh:NodeShape ;
  sh:targetClass role:ARCHIVED_EXTERNAL_CONTENT ;
  sh:property [ sh:path p:content_sha256 ; sh:pattern "^[a-f0-9]{64}$" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p:byte_length ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p:media_type ; sh:minLength 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p:public_blob_committed ; sh:hasValue false ; sh:minCount 1 ; sh:maxCount 1 ] .

archive:Attempt a sh:NodeShape ;
  sh:targetClass role:SOURCE_RETRIEVAL ;
  sh:property [ sh:path p:retrieved_at ; sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:or (
    [ sh:property [ sh:path p:retrieval_status ; sh:hasValue "ARCHIVED" ] ;
      sh:property [ sh:path r:GENERATED ; sh:minCount 1 ; sh:maxCount 1 ; sh:class role:ARCHIVED_EXTERNAL_CONTENT ] ]
    [ sh:property [ sh:path p:retrieval_status ; sh:hasValue "FAILED" ] ;
      sh:property [ sh:path r:GENERATED ; sh:maxCount 0 ] ;
      sh:property [ sh:path p:failure_reason ; sh:minLength 1 ; sh:minCount 1 ] ]
  ) .

archive:Citation a sh:NodeShape ;
  sh:targetClass role:CITATION_OCCURRENCE ;
  sh:property [ sh:path p:source_sha256 ; sh:pattern "^[a-f0-9]{64}$" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p:source_path ; sh:minLength 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p:citation_locator ; sh:minLength 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path r:REFERS_TO ; sh:minCount 1 ; sh:maxCount 1 ] .
