PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
SELECT DISTINCT ?record ?reason WHERE {
 { ?record p:standard_graph_role ?recordRole . VALUES ?recordRole { "LOCAL_VALIDATION_RECORD" "LEARNING_VALIDATION_RECORD" "READ_VALIDATION_RECORD" "JOINT_VALIDATION_RECORD" "SCALE_VALIDATION_RECORD" "HYPERON_VALIDATION_RECORD" }
 VALUES ?component {"INPUT_TOKENS" "OUTPUT_TOKENS" "REASONING_TOKENS" "READ_TOKENS" "UPDATE_TOKENS" "RETRY_TOKENS" "WALL_TIME_MS" "REQUEST_COUNT"}
   FILTER NOT EXISTS {?record r:HAS_COST ?cost . ?cost p:component ?component}
   BIND(CONCAT("MISSING_COST_", ?component) AS ?reason) }
 UNION { ?record p:standard_graph_role ?recordRole . VALUES ?recordRole { "LOCAL_VALIDATION_RECORD" "LEARNING_VALIDATION_RECORD" "READ_VALIDATION_RECORD" "JOINT_VALIDATION_RECORD" "SCALE_VALIDATION_RECORD" "HYPERON_VALIDATION_RECORD" }
 ?record r:HAS_COST ?cost . ?cost p:measurement_status ?status; p:amount ?amount . FILTER(?status IN ("UNREPORTED", "NOT_APPLICABLE")) BIND("UNMEASURED_COST_HAS_AMOUNT" AS ?reason) }
 UNION { ?record p:standard_graph_role ?recordRole . VALUES ?recordRole { "LOCAL_VALIDATION_RECORD" "LEARNING_VALIDATION_RECORD" "READ_VALIDATION_RECORD" "JOINT_VALIDATION_RECORD" "SCALE_VALIDATION_RECORD" "HYPERON_VALIDATION_RECORD" }
 ?record r:HAS_COST ?cost . ?cost p:component ?component; p:unit ?unit . FILTER((?component = "WALL_TIME_MS" && ?unit != "MILLISECOND") || (?component = "REQUEST_COUNT" && ?unit != "REQUEST") || (?component NOT IN ("WALL_TIME_MS", "REQUEST_COUNT") && ?unit != "TOKEN")) BIND("COST_UNIT_MISMATCH" AS ?reason) }
 UNION { ?record p:standard_graph_role ?recordRole . VALUES ?recordRole { "LOCAL_VALIDATION_RECORD" "LEARNING_VALIDATION_RECORD" "READ_VALIDATION_RECORD" "JOINT_VALIDATION_RECORD" "SCALE_VALIDATION_RECORD" "HYPERON_VALIDATION_RECORD" }
 ?record r:HAS_COST ?left, ?right . ?left p:component ?component . ?right p:component ?component . FILTER(?left != ?right) BIND("DUPLICATE_COST_COMPONENT" AS ?reason) }
 UNION { ?record p:standard_graph_role ?recordRole . VALUES ?recordRole { "LOCAL_VALIDATION_RECORD" "LEARNING_VALIDATION_RECORD" "READ_VALIDATION_RECORD" "JOINT_VALIDATION_RECORD" "SCALE_VALIDATION_RECORD" "HYPERON_VALIDATION_RECORD" }
 ?record p:standard_graph_role "LEARNING_VALIDATION_RECORD" . FILTER NOT EXISTS {?record p:control_arm ?arm} BIND("MISSING_CONTROL_ARM" AS ?reason) }
 UNION { ?record p:standard_graph_role ?recordRole . VALUES ?recordRole { "LOCAL_VALIDATION_RECORD" "LEARNING_VALIDATION_RECORD" "READ_VALIDATION_RECORD" "JOINT_VALIDATION_RECORD" "SCALE_VALIDATION_RECORD" "HYPERON_VALIDATION_RECORD" }
 ?record p:standard_graph_role "HYPERON_VALIDATION_RECORD" . VALUES ?pin {p:hyperon_commit p:hyperon_config_digest p:adapter_digest p:information_manifest_digest p:budget_contract_digest}
   FILTER NOT EXISTS {?record ?pin ?value} BIND("MISSING_HYPERON_COMPARISON_PIN" AS ?reason) }
 UNION { ?record p:standard_graph_role ?recordRole . VALUES ?recordRole { "LOCAL_VALIDATION_RECORD" "LEARNING_VALIDATION_RECORD" "READ_VALIDATION_RECORD" "JOINT_VALIDATION_RECORD" "SCALE_VALIDATION_RECORD" "HYPERON_VALIDATION_RECORD" }
 ?record r:HAS_PARTICIPATION ?left, ?right . ?left p:slot_ordinal ?slot . ?right p:slot_ordinal ?slot . FILTER(?left != ?right) BIND("DUPLICATE_PARTICIPATION_SLOT" AS ?reason) }
 UNION { ?record p:standard_graph_role ?role . FILTER((STRSTARTS(?role,"VALIDATION_") && STRENDS(?role,"_RECORD")) || STRENDS(?role,"_VALIDATION_RECORD"))
   FILTER(?role NOT IN ("LOCAL_VALIDATION_RECORD","LEARNING_VALIDATION_RECORD","READ_VALIDATION_RECORD","JOINT_VALIDATION_RECORD","SCALE_VALIDATION_RECORD","HYPERON_VALIDATION_RECORD","VALIDATION_PROTOCOL_RECORD","VALIDATION_EXECUTION_RECORD","VALIDATION_OUTCOME_RECORD","VALIDATION_SPLIT_RECORD","VALIDATION_CASE_RECORD","VALIDATION_COST_RECORD","VALIDATION_PARTICIPATION_RECORD","VALIDATION_REVISION_RECORD","VALIDATION_FRESH_READ_RECORD","VALIDATION_JOINT_TUPLE_RECORD","VALIDATION_SCALE_BINDING_RECORD"))
   BIND("UNSUPPORTED_VALIDATION_RECORD_ROLE" AS ?reason) }
 UNION { ?record p:standard_graph_role ?supportRole . VALUES (?supportRole ?requiredLink) {
   ("VALIDATION_EXECUTION_RECORD" r:HAS_EXECUTION) ("VALIDATION_OUTCOME_RECORD" r:HAS_OUTCOME)
   ("VALIDATION_COST_RECORD" r:HAS_COST) ("VALIDATION_PARTICIPATION_RECORD" r:HAS_PARTICIPATION)
   ("VALIDATION_REVISION_RECORD" r:HAS_REVISION) ("VALIDATION_FRESH_READ_RECORD" r:HAS_FRESH_READ)
   ("VALIDATION_JOINT_TUPLE_RECORD" r:HAS_JOINT_TUPLE) ("VALIDATION_SCALE_BINDING_RECORD" r:HAS_SCALE_BINDING) }
   FILTER NOT EXISTS { ?source ?requiredLink ?record . ?source p:standard_graph_role ?sourceRole . VALUES ?sourceRole {"LOCAL_VALIDATION_RECORD" "LEARNING_VALIDATION_RECORD" "READ_VALIDATION_RECORD" "JOINT_VALIDATION_RECORD" "SCALE_VALIDATION_RECORD" "HYPERON_VALIDATION_RECORD"} }
   BIND("UNREFERENCED_SUPPORT_RECORD" AS ?reason) }
} ORDER BY ?record ?reason
