PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>

SELECT ?task ?prerequisite ?prerequisiteStatus WHERE {
  VALUES ?root { <urn:hswm:kg:node:sym:AbstractNode:hswm-w1-full-instrument-progress-2026-10-07-v1> }
  ?root a role:PROGRESS_VIEW ; r:HAS_CONCEPT ?selector .
  ?selector a role:CURRENT_SELECTION ; p:task_id ?task ; p:task_uid ?taskUid ; p:selected_observation_uid ?selectedUid ; r:REFERENCES ?originalTask, ?observation .
  ?originalTask a role:TASK ; p:task_id ?task ; r:REQUIRES ?requiredTask .
  ?observation a role:TASK_STATUS_OBSERVATION ; p:task_id ?task ; p:completion_disposition ?completion .
  FILTER(?completion != "COMPLETE")
  FILTER(STR(?originalTask) = CONCAT("urn:hswm:kg:node:", ?taskUid))
  FILTER(STR(?observation) = CONCAT("urn:hswm:kg:node:", ?selectedUid))
  ?requiredTask a role:TASK ; p:task_id ?prerequisite .
  OPTIONAL {
    ?root r:HAS_CONCEPT ?requiredSelector .
    ?requiredSelector a role:CURRENT_SELECTION ; p:task_id ?prerequisite ; p:task_uid ?requiredUid ; p:selected_observation_uid ?requiredObservationUid ; r:REFERENCES ?requiredTask, ?requiredObservation .
    ?requiredObservation a role:TASK_STATUS_OBSERVATION ; p:task_id ?prerequisite ; p:completion_disposition ?observedStatus .
    FILTER(STR(?requiredTask) = CONCAT("urn:hswm:kg:node:", ?requiredUid))
    FILTER(STR(?requiredObservation) = CONCAT("urn:hswm:kg:node:", ?requiredObservationUid))
  }
  BIND(COALESCE(?observedStatus, "UNOBSERVED") AS ?prerequisiteStatus)
  FILTER(?prerequisiteStatus != "COMPLETE")
}
ORDER BY ?task ?prerequisite
