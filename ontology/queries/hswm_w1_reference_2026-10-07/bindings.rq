PREFIX p: <https://hswm.invalid/kg-bundle-rdf/v1/prop/>
PREFIX r: <https://hswm.invalid/kg-bundle-rdf/v1/rel/>
PREFIX role: <https://hswm.invalid/kg-bundle-rdf/v1/role/>
SELECT ?path ?sha256 ?revision ?evidenceRole WHERE {
  VALUES ?root { <urn:hswm:kg:node:sym:AbstractNode:hswm-w1-reference-lean-2026-10-07-v1> }
  ?root a role:FORMAL_REFERENCE_AUDIT ; r:HAS_SOURCE ?source .
  ?source a role:EVIDENCE_ARTIFACT ; p:source_path ?path ; p:source_sha256 ?sha256 ;
    p:source_revision ?revision ; p:evidence_role ?evidenceRole .
} ORDER BY ?path
