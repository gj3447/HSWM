 sh:property [ sh:path p:reviewed_revision ; sh:pattern "^[a-f0-9]{40}$" ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path r:HAS_CONCEPT ; sh:minCount 32 ; sh:maxCount 32 ] ;
 sh:property [ sh:path r:HAS_CONCEPT ; sh:qualifiedValueShape [ sh:class role:W1_REFERENCE_THEOREM ] ; sh:qualifiedMinCount 22 ; sh:qualifiedMaxCount 22 ] ;
