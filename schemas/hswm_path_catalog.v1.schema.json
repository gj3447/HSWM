{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/HSWM/schemas/hswm_path_catalog.v1.schema.json",
  "title": "HSWM path catalog v1",
  "type": "object",
  "required": ["schema_version", "ontology", "entry_count", "concept_counts", "entries"],
  "properties": {
    "schema_version": {"const": "hswm-path-catalog/v1"},
    "ontology": {"const": "ontology/HSWM_REPOSITORY_ONTOLOGY.v1.json"},
    "entry_count": {"type": "integer", "minimum": 1},
    "concept_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "storage_role", "concepts"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "storage_role": {
            "enum": ["PUBLIC_ROOT", "LEGACY_PATH_BOUND_ROOT", "CANONICAL_DIRECTORY"]
          },
          "concepts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
