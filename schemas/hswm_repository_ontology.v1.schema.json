{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/HSWM/schemas/hswm_repository_ontology.v1.schema.json",
  "title": "HSWM repository ontology v1",
  "type": "object",
  "required": [
    "schema_version",
    "root_uid",
    "concepts",
    "relations",
    "mounts",
    "public_root_surface",
    "legacy_root_inventory",
    "python_root_migrations",
    "python_root_classification",
    "path_catalog",
    "legacy_replay",
    "learning_analogy",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {"const": "hswm-repository-ontology/v1"},
    "root_uid": {"type": "string", "minLength": 1},
    "concepts": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["uid", "label", "directory", "definition"],
        "properties": {
          "uid": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "directory": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "relations": {"type": "array", "minItems": 1},
    "mounts": {"type": "array", "minItems": 1},
    "public_root_surface": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "legacy_root_inventory": {"type": "string"},
    "python_root_migrations": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    },
    "python_root_classification": {"type": "string", "minLength": 1},
    "path_catalog": {"type": "string"},
    "legacy_replay": {
      "type": "object",
      "required": ["tool", "command", "source_of_truth", "workspace_kind", "invariants"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "source_of_truth": {"const": "python_root_migrations"},
        "workspace_kind": {"const": "detached-standalone-clone"},
        "invariants": {
          "type": "array",
          "minItems": 4,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "learning_analogy": {"type": "object"},
    "nonclaims": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
