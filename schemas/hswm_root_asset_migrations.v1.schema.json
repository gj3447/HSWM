{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/HSWM/schemas/hswm_root_asset_migrations.v1.schema.json",
  "title": "HSWM non-Python root asset migrations v1",
  "type": "object",
  "required": ["$schema", "schema_version", "status", "source_commit", "migrations"],
  "properties": {
    "$schema": {"const": "../../schemas/hswm_root_asset_migrations.v1.schema.json"},
    "schema_version": {"const": "hswm-root-asset-migrations/v1"},
    "status": {"const": "SOURCE_PINNED_PATH_MIGRATION"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policy": {"type": "string", "minLength": 1},
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["old_path", "canonical_path", "destination_kind", "source_sha256"],
        "properties": {
          "old_path": {
            "type": "string",
            "pattern": "^[^/\\\\]+\\.(md|json|txt|log|sh)$"
          },
          "canonical_path": {
            "type": "string",
            "pattern": "^(docs/(canon|research|archive)|evidence|prereg|manifests|research|results|receipts|scripts)/(?:(?!\\.{1,2}/)[^/\\\\]+/)*[^/\\\\]+\\.(md|json|txt|log|sh)$"
          },
          "destination_kind": {
            "enum": [
              "canon-document",
              "research-document",
              "archive-document",
              "evidence",
              "preregistration",
              "manifest",
              "research-record",
              "result",
              "receipt",
              "source-text",
              "run-log",
              "maintenance-shell"
            ]
          },
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
