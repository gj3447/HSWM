{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/HSWM/schemas/hswm_semantic_weight_metric_contract.v1.schema.json",
  "title": "HSWM Semantic Weight Metric Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "status",
    "created_at",
    "authority",
    "scope",
    "weight_planes",
    "formulae",
    "required_arms",
    "required_metric_ids",
    "parity_fields",
    "intervention_invariants",
    "statistics",
    "thresholds",
    "firewalls",
    "measurement_gate",
    "source_artifacts",
    "runtime_artifacts",
    "schema_binding"
  ],
  "properties": {
    "schema_version": {
      "const": "hswm-semantic-weight-metric-contract/v1"
    },
    "contract_id": {
      "const": "HSWM_SEMANTIC_WEIGHT_METRIC_CONTRACT_V1_20260726"
    },
    "status": {
      "const": "ENGINEERING_DRAFT_UNRATIFIED"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_ratified",
        "scientific_status",
        "scientific_judgment_emitted",
        "kg_write_state",
        "external_governance"
      ],
      "properties": {
        "user_ratified": {"const": false},
        "scientific_status": {"const": "UNJUDGED"},
        "scientific_judgment_emitted": {"const": false},
        "kg_write_state": {"const": "NOT_WRITTEN"},
        "external_governance": {"const": "NONE"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implemented_weight_scope",
        "target_weight_scope",
        "causal_question",
        "claim_boundary",
        "excluded_claims"
      ],
      "properties": {
        "implemented_weight_scope": {"const": "scalar_slow_efficacy_v1"},
        "target_weight_scope": {"const": "operator_semantic_weight_future"},
        "causal_question": {"type": "string", "minLength": 1},
        "claim_boundary": {"type": "string", "minLength": 1},
        "excluded_claims": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "weight_planes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plane_id", "symbol", "domain", "semantics", "learning", "claim_use"],
        "properties": {
          "plane_id": {
            "enum": [
              "query_gate",
              "boost_channel",
              "slow_log_salience",
              "learned_fast_efficacy"
            ]
          },
          "symbol": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "semantics": {"type": "string", "minLength": 1},
          "learning": {"type": "string", "minLength": 1},
          "claim_use": {
            "enum": [
              "EXCLUDED_FROM_LEARNED_W_CLAIM",
              "SCALAR_CAUSAL_SHADOW_ONLY",
              "TARGET_NOT_IMPLEMENTED"
            ]
          }
        }
      }
    },
    "formulae": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implemented_readout",
        "implemented_update",
        "full",
        "removed",
        "shuffled",
        "restored",
        "routing_actuation"
      ],
      "properties": {
        "implemented_readout": {"type": "string", "minLength": 1},
        "implemented_update": {"type": "string", "minLength": 1},
        "full": {"type": "string", "minLength": 1},
        "removed": {"type": "string", "minLength": 1},
        "shuffled": {"type": "string", "minLength": 1},
        "restored": {"type": "string", "minLength": 1},
        "routing_actuation": {"type": "string", "minLength": 1}
      }
    },
    "required_arms": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm_id", "purpose", "w_mount", "information_rule", "compute_rule"],
        "properties": {
          "arm_id": {
            "enum": [
              "NO_SHARED_STATE",
              "EMBEDDING_ONLY",
              "HYPERGRAPH_ONLY",
              "FROZEN_NO_WRITE",
              "STRONG_CONTEXT_VECTOR_EQUAL_INFO",
              "W_UNIFORM_L1_MATCHED",
              "W_RANDOM_UPDATE_MATCHED",
              "W_FULL_LEARNED",
              "W_REMOVED_BASE",
              "W_SHUFFLED_WITHIN_STRATUM",
              "W_RESTORED_EXACT"
            ]
          },
          "purpose": {"type": "string", "minLength": 1},
          "w_mount": {"type": "string", "minLength": 1},
          "information_rule": {"type": "string", "minLength": 1},
          "compute_rule": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_metric_ids": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "parity_fields": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "intervention_invariants": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "aggregation",
        "bootstrap_samples",
        "bootstrap_seed",
        "bootstrap_interval",
        "confidence",
        "seed_direction_rule",
        "baseline_selection"
      ],
      "properties": {
        "unit": {"const": "world_or_connected_component_cluster"},
        "aggregation": {"const": "macro_then_paired_cluster_bootstrap"},
        "bootstrap_samples": {"type": "integer", "minimum": 10000},
        "bootstrap_seed": {"const": 20260726},
        "bootstrap_interval": {"const": "paired_percentile_95"},
        "confidence": {"const": 0.95},
        "seed_direction_rule": {"const": "at_least_4_of_5_same_positive_direction"},
        "baseline_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "allowlist", "rule"],
          "properties": {
            "status": {"const": "UNSELECTED_BLOCKS_MEASUREMENT"},
            "allowlist": {
              "const": [
                "FROZEN_NO_WRITE",
                "STRONG_CONTEXT_VECTOR_EQUAL_INFO",
                "W_UNIFORM_L1_MATCHED"
              ]
            },
            "rule": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learned_gain_abs_min",
        "paired_lcb_min_exclusive",
        "removal_erasure_fraction_min",
        "shuffle_erasure_fraction_min",
        "random_update_erasure_fraction_min",
        "restoration_recovery_fraction_min",
        "restoration_equivalence_rope",
        "context_operator_delta_min",
        "retention_loss_max",
        "negative_transfer_rate_max",
        "route_divergence_cases_min"
      ],
      "properties": {
        "learned_gain_abs_min": {"const": 0.05},
        "paired_lcb_min_exclusive": {"const": 0.0},
        "removal_erasure_fraction_min": {"const": 0.7},
        "shuffle_erasure_fraction_min": {"const": 0.7},
        "random_update_erasure_fraction_min": {"const": 0.7},
        "restoration_recovery_fraction_min": {"const": 0.9},
        "restoration_equivalence_rope": {"const": [-0.02, 0.02]},
        "context_operator_delta_min": {"const": 0.03},
        "retention_loss_max": {"const": 0.03},
        "negative_transfer_rate_max": {"const": 0.1},
        "route_divergence_cases_min": {"const": 1}
      }
    },
    "firewalls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibility_pre_outcome",
        "answer_pre_gold",
        "natural_language_learning_state_forbidden",
        "cache_hits_required",
        "f1_cohort_reuse_forbidden",
        "void_on_hash_or_parity_drift"
      ],
      "properties": {
        "eligibility_pre_outcome": {"const": true},
        "answer_pre_gold": {"const": true},
        "natural_language_learning_state_forbidden": {"const": true},
        "cache_hits_required": {"const": 0},
        "f1_cohort_reuse_forbidden": {"const": true},
        "void_on_hash_or_parity_drift": {"const": true}
      }
    },
    "measurement_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_authorized",
        "f1_completed_and_adjudicated",
        "user_ratified",
        "machine_locked",
        "fresh_cohort_frozen",
        "strongest_baseline_selected",
        "independent_judge_frozen",
        "external_governance_required"
      ],
      "properties": {
        "measurement_authorized": {"const": false},
        "f1_completed_and_adjudicated": {"const": false},
        "user_ratified": {"const": false},
        "machine_locked": {"const": false},
        "fresh_cohort_frozen": {"const": false},
        "strongest_baseline_selected": {"const": false},
        "independent_judge_frozen": {"const": false},
        "external_governance_required": {"const": false}
      }
    },
    "source_artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "runtime_artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "schema_binding": {
      "$ref": "#/$defs/artifact"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "role"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  }
}
