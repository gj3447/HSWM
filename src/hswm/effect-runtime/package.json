{
  "name": "@hswm/effect-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hswm-hypergraph-projection": "./dist/hypergraph-projection-process.js",
    "hswm-graph-loop-job": "./dist/canonical-atom-v2-graph-loop-job-process.js",
    "hswm-local-permit-commit": "./dist/canonical-atom-v2-local-permit-commit-process.js",
    "hswm-g0-temporal-rehearsal-worker": "./dist/g0-occurrence-temporal-worker-process.js",
    "hswm-live": "./dist/hswm-live-process.js",
    "hswm-dev": "./dist/hswm-dev-process.js",
    "hswm-reluvator-check": "./dist/reluvator-check-process.js",
    "hswm-backup": "./dist/development-backup-process.js",
    "hswm-research-graph": "./dist/research-graph-process.js",
    "hswm-kg-bundle": "./dist/native-kg-process.js",
    "hswm-task": "./dist/native-task-process.js",
    "hswm-knowledge-catalog": "./dist/knowledge-catalog-process.js",
    "hswm-usl": "./dist/native-usl-process.js",
    "hswm-g0-occurrence": "./dist/native-occurrence-process.js",
    "hswm-legacy-replay": "./dist/native-legacy-replay-process.js",
    "hswm-markdown-math": "./dist/native-markdown-math-process.js",
    "hswm-research-fabric": "./dist/native-research-fabric-process.js",
    "hswm-verify-efficacy": "./dist/native-efficacy-process.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./g0-temporal": {
      "types": "./dist/g0-occurrence-temporal-public.d.ts",
      "default": "./dist/g0-occurrence-temporal-public.js"
    }
  },
  "files": [
    "assets",
    "dist",
    "src",
    "README.md"
  ],
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.13.0"
  },
  "scripts": {
    "projection:rehearsal": "node dist/hypergraph-projection-process.js --rehearsal",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.temporal-build.json",
    "build:dnrd": "tsc -p tsconfig.dnrd.json",
    "check": "tsc --noEmit && tsc -p tsconfig.temporal.json && node scripts/lint-effect-boundary.mjs && npm run check:adaptive-functional",
    "lint:boundary": "node scripts/lint-effect-boundary.mjs",
    "test": "vitest run",
    "test:g0-temporal:integration": "HSWM_RUN_G0_TEMPORAL_INTEGRATION=1 vitest run test/g0-occurrence-temporal.integration.test.ts --maxWorkers=1",
    "verify": "npm run check && npm run test && npm run build && npm run build:dnrd && npm pack --dry-run",
    "test:adaptive": "vitest run ../../../tests/effect-runtime/adaptive-",
    "check:adaptive-functional": "node scripts/lint-adaptive-functional.mjs",
    "test:watch": "vitest --maxWorkers=2",
    "test:changed": "vitest run --changed --maxWorkers=2",
    "test:native-migration": "vitest run test/native- test/general-json-domain.test.ts test/knowledge-catalog- test/research-tooling-parity.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "@comunica/query-sparql-rdfjs": "5.3.0",
    "@effect/opentelemetry": "0.64.0",
    "@effect/platform": "0.97.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.208.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-logs": "0.208.0",
    "@opentelemetry/sdk-metrics": "2.2.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "@opentelemetry/sdk-trace-node": "2.2.0",
    "@opentelemetry/sdk-trace-web": "2.2.0",
    "@opentelemetry/semantic-conventions": "1.34.0",
    "@rdfjs/types": "2.0.1",
    "@temporalio/activity": "1.23.0",
    "@temporalio/client": "1.23.0",
    "@temporalio/common": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.23.0",
    "effect": "3.22.1",
    "jsonld": "9.0.0",
    "n3": "2.7.2",
    "neo4j-driver": "6.2.0",
    "rdf-canonize": "5.0.0",
    "rdf-validate-shacl": "0.6.5"
  },
  "devDependencies": {
    "@effect/language-service": "0.23.3",
    "@effect/vitest": "0.30.0",
    "@temporalio/testing": "1.23.0",
    "@types/jsonld": "1.5.15",
    "@types/n3": "1.26.3",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
