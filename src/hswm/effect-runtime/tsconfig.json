{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": false,
    "baseUrl": ".",
    "paths": {
      "effect": ["node_modules/effect/dist/dts/index.d.ts"],
      "@effect/vitest": ["node_modules/@effect/vitest/dist/dts/index.d.ts"],
      "vitest": ["node_modules/vitest/dist/index.d.ts"],
      "neo4j-driver": ["node_modules/neo4j-driver/types/index.d.ts"],
      "n3": ["node_modules/@types/n3/index.d.ts"]
    },
    "typeRoots": ["node_modules/@types"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true
      }
    ]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../../../tests/effect-runtime/**/*.ts"],
  "exclude": [
    "src/g0-occurrence-temporal-audit.ts",
    "src/g0-occurrence-temporal-activities.ts",
    "src/g0-occurrence-temporal-contract.ts",
    "src/g0-occurrence-temporal-public.ts",
    "src/g0-occurrence-temporal-runtime.ts",
    "src/g0-occurrence-temporal-worker-process.ts",
    "src/g0-occurrence-temporal-workflow.ts",
    "test/g0-occurrence-temporal-runtime.test.ts",
    "test/g0-occurrence-temporal-audit.test.ts",
    "test/g0-occurrence-temporal-worker-process.test.ts",
    "test/g0-occurrence-temporal.integration.test.ts"
  ]
}
